# ==============================================================================
# FALCÃO LIMPEZA — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto (ou backend/.env) e configure
# os valores de acordo com o ambiente local ou de produção.
# NUNCA comite arquivos .env contendo credenciais ou segredos reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplicação e Ambiente
# ------------------------------------------------------------------------------
APP_NAME="Falcão Limpeza API"
# Opções: development | staging | production | test
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
# Formato padrão: postgresql+asyncpg://<usuario>:<senha>@<host>:<porta>/<banco>
# Exemplo para Docker Compose local: postgresql+asyncpg://falcao:falcao@localhost:5433/falcao_limpeza
DATABASE_URL=postgresql+asyncpg://falcao:falcao@localhost:5433/falcao_limpeza

# Configurações do serviço Postgres no Docker Compose (compose.yaml):
POSTGRES_USER=falcao
POSTGRES_PASSWORD=falcao
POSTGRES_DB=falcao_limpeza
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 3. CORS e URLs de Integração
# ------------------------------------------------------------------------------
# Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:8000
PUBLIC_SITE_BASE_URL=http://localhost:4321
# IndexNow (Bing e afins): chave pública de 8-128 caracteres [a-zA-Z0-9-], servida em /<chave>.txt. Vazia = desligado.
INDEXNOW_KEY=
CMS_FRONTEND_URL=http://localhost:4321/cms

# ------------------------------------------------------------------------------
# 4. Frontend Astro (BFF / SSR)
# ------------------------------------------------------------------------------
# URL da API FastAPI consumida internamente pelas rotas SSR do Astro (/api/*)
# Em ambiente Docker interno: http://backend:8000
# Em desenvolvimento local fora do container: http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
BACKEND_PORT=8000
FRONTEND_PORT=4321

# ------------------------------------------------------------------------------
# 5. Autenticação Administrativa — e-mail + senha (argon2id)
# ------------------------------------------------------------------------------
# A senha NÃO fica no .env: é definida/trocada no servidor pelo comando
#   docker compose exec backend uv run --no-sync python -m app.cli set-password email@dominio
# (pede a senha duas vezes, mínimo 12 caracteres, e derruba as sessões abertas).

# Chave secreta forte (mínimo 32 caracteres) para assinatura de tokens de sessão do CMS
CMS_SESSION_SECRET=chave-secreta-forte-com-ao-menos-32-caracteres-dev

# Lista de e-mails autorizados a acessar o painel CMS (separados por vírgula)
CMS_ALLOWED_EMAILS=admin@falcaolimpeza.com.br,admin@falcaolimpeza.com.br

# Tempos de expiração de token (minutos / dias)
CMS_ACCESS_TOKEN_TTL_MINUTES=15
CMS_REFRESH_TOKEN_TTL_DAYS=30

# Cookie seguro em produção (true exige HTTPS)
CMS_COOKIE_SECURE=false
CMS_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 6. Notificações e Despacho de E-mails — Resend
# ------------------------------------------------------------------------------
# Chave da API do Resend (obter em https://resend.com)
RESEND_API_KEY=re_123456789_exemplo

# E-mail remetente autenticado no domínio (ex: admin@falcaolimpeza.com.br)
CONTACT_FROM_EMAIL=admin@falcaolimpeza.com.br

# Destinatário padrão para receber notificações de novos contatos/leads
CONTACT_TO_EMAIL=admin@falcaolimpeza.com.br

# Lista adicional de destinatários de notificações (separados por vírgula)
CONTACT_NOTIFICATION_RECIPIENTS=admin@falcaolimpeza.com.br

# Ativação do despachante assíncrono em segundo plano
CONTACT_EMAIL_ENABLED=true
CONTACT_DISPATCH_INTERVAL_SECONDS=60
CONTACT_DISPATCH_MAX_ATTEMPTS=5
CONTACT_DISPATCH_BATCH_SIZE=20

# Proteção antispam e rate limiting
CONTACT_MIN_FILL_SECONDS=3
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 8. Telemetria e Analytics Autônomo
# ------------------------------------------------------------------------------
ANALYTICS_ENABLED=true
# Período de retenção em dias para limpeza automática de logs brutos (conformidade LGPD)
ANALYTICS_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 9. Armazenamento de Arquivos e Uploads (CMS)
# ------------------------------------------------------------------------------
# Armazenamento local (padrão)
CMS_UPLOAD_DIR=.cms-uploads

# Armazenamento em nuvem Azure Blob Storage (opcional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cms-uploads

# ------------------------------------------------------------------------------
# 10. Deploy (só no .env.production, lido pelo deploy/deploy.ps1)
# ------------------------------------------------------------------------------
# Em produção: ENVIRONMENT=production, PUBLIC_SITE_BASE_URL/CORS_ORIGINS = https://<dominio>,
# CMS_FRONTEND_URL = https://<dominio>/cms, POSTGRES_PASSWORD só [A-Za-z0-9] (openssl rand -hex 24).
VPS_HOST=
VPS_USER=ubuntu
VPS_SSH_KEY=
VPS_APP_DIR=/home/ubuntu/falcao-limpeza
# Vazio = certificado sem e-mail de aviso de expiração.
CERTBOT_EMAIL=
# Domínio *.duckdns.org: o deploy.ps1 -Setup instala na VM o cron que aponta o domínio para ela.
DUCK_DNS_DOMAIN=
DUCK_DNS_TOKEN=
