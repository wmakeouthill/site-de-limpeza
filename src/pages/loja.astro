---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import StoreMap from '@/features/store/components/StoreMap.astro';
import { NeighborhoodChecker } from '@/features/store/components/NeighborhoodChecker';
import { getPublicSiteSettings } from '@/lib/server/publicSettings';
import { buildGreeting } from '@/features/list/utils/whatsappFormatter';

export const prerender = false;

const settings = await getPublicSiteSettings();
const cleanNumber = settings.whatsapp_numero.replace(/\D/g, "");
const greeting = buildGreeting(settings.loja_nome);
const waUrl = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(`${greeting} Vim pelo site e queria tirar uma dúvida.`)}`;

// Formatação amigável de dias da semana
const DIAS_NOMES = [
  "Segunda-feira",
  "Terça-feira",
  "Quarta-feira",
  "Quinta-feira",
  "Sexta-feira",
  "Sábado",
  "Domingo",
];

function formatDiasSemana(dias: number[]): string {
  if (!dias || dias.length === 0) return "";
  if (dias.length === 7) return "Todos os dias";
  if (dias.length === 6 && !dias.includes(6)) return "Segunda a sábado";
  if (dias.length === 5 && !dias.includes(5) && !dias.includes(6)) return "Segunda a sexta";
  return dias.map((d) => DIAS_NOMES[d] || String(d)).join(", ");
}
---

<BaseLayout
  title={`A Loja · Localização e Horários · ${settings.loja_nome}`}
  description="Conheça a Falcão Limpeza no Anil, Jacarepaguá. Endereço, horários, mapa interativo e consulta de bairros atendidos para entrega."
  settings={settings}
>
  <Nav
    articlesEnabled={settings.articles_enabled}
    guidesEnabled={settings.guides_enabled}
    settings={settings}
  />

  <main id="main">
    {/* Cabeçalho da Página */}
    <section class="loja-hero">
      <div class="wrap">
        <p class="eyebrow">A loja</p>
        <h1 class="loja-hero-title">Venha ver de perto.</h1>
        <p class="loja-hero-lede">
          No Anil, na Estrada de Jacarepaguá, pertinho de Rio das Pedras.
          Mande a lista antes e encontre tudo separado.
        </p>
      </div>
    </section>

    {/* Grid com Mapa e Cartões */}
    <section class="loja-content-section">
      <div class="wrap loja-layout-grid">
        {/* Coluna da esquerda: mapa interativo */}
        <div class="loja-map-box">
          <StoreMap nome={settings.loja_nome} endereco={settings.endereco} />
        </div>

        {/* Coluna da direita: 4 Cartões Práticos */}
        <div class="loja-cards-list">
          <!-- Cartão Endereço -->
          <div class="lcard">
            <h3 class="lcard-title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Endereço
            </h3>
            <address id="end-txt" class="lcard-body not-italic">
              <strong>{settings.endereco}</strong><br />
              {settings.bairro_cidade}
              {settings.referencia_endereco && (
                <><br /><span class="text-ink-2 text-sm">{settings.referencia_endereco}</span></>
              )}
            </address>
            <div class="lcard-actions">
              {settings.maps_url && (
                <a
                  href={settings.maps_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-lcard-primary"
                >
                  Abrir no Google Maps &rarr;
                </a>
              )}
              <button
                type="button"
                id="btn-copiar-end"
                class="btn-lcard-secondary"
                data-address={`${settings.endereco}, ${settings.bairro_cidade}`}
              >
                Copiar endereço
              </button>
            </div>
          </div>

          <!-- Cartão Horário -->
          <div class="lcard">
            <h3 class="lcard-title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Horário de funcionamento
            </h3>
            <div class="lcard-body">
              {settings.horarios && settings.horarios.length > 0 ? (
                <ul class="horarios-list">
                  {settings.horarios.map((h) => (
                    <li>
                      <strong>{formatDiasSemana(h.dias_semana)}:</strong> {h.abre} às {h.fecha}
                    </li>
                  ))}
                </ul>
              ) : (
                <p>Segunda a sábado, 8h às 19h<br />Domingo, 8h às 13h</p>
              )}
              {settings.horario_obs && (
                <p class="horario-obs">{settings.horario_obs}</p>
              )}
            </div>
          </div>

          <!-- Cartão WhatsApp -->
          <div class="lcard">
            <h3 class="lcard-title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              WhatsApp
            </h3>
            <div class="lcard-body">
              <p class="text-lg font-bold text-ink">
                {settings.telefone_exibicao || settings.whatsapp_numero}
              </p>
              <p class="text-sm text-ink-2">
                Atendimento rápido para tirar dúvidas, consultar produtos e combinar entrega.
              </p>
            </div>
            <div class="lcard-actions">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-lcard-zap"
              >
                Chamar no WhatsApp
              </a>
            </div>
          </div>

          <!-- Cartão Pagamento -->
          <div class="lcard">
            <h3 class="lcard-title">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
              Formas de pagamento
            </h3>
            <div class="lcard-body">
              <p>{settings.pagamento || "Pix, cartão de débito e crédito, dinheiro."}</p>
              {settings.chave_pix && (
                <p class="text-sm text-ink-2 mt-2">
                  <b>Chave Pix:</b> {settings.chave_pix}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Seção Consulta de Bairros Atendidos (RF-P09, CA-11) */}
    <section class="loja-entrega-section" id="entrega">
      <div class="wrap">
        <div class="sec-head text-center">
          <p class="eyebrow">Entrega</p>
          <h2>Entrega no seu bairro?</h2>
          <p class="sec-sub mx-auto">
            Digite seu bairro pra ver se a gente costuma atender. A confirmação é sempre pelo WhatsApp.
          </p>
        </div>

        <NeighborhoodChecker
          client:load
          bairros={settings.bairros_entrega}
          lojaNome={settings.loja_nome}
          whatsappNumero={settings.whatsapp_numero}
        />
      </div>
    </section>
  </main>

  <Footer settings={settings} />
</BaseLayout>

<script is:inline>
  (function() {
    var btn = document.getElementById('btn-copiar-end');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var addr = btn.getAttribute('data-address') || '';
      if (navigator.clipboard) {
        navigator.clipboard.writeText(addr).then(function() {
          if (window.showToast) window.showToast('Endereço copiado!');
          btn.textContent = 'Copiado!';
          setTimeout(function() {
            btn.textContent = 'Copiar endereço';
          }, 2500);
        });
      }
    });
  })();
</script>

<style>
  .loja-hero {
    padding: 48px 0 28px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .loja-hero-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 900;
    margin: 8px 0 14px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .loja-hero-lede {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 640px;
    margin: 0;
  }

  .loja-content-section {
    padding: 48px 0;
  }

  .loja-layout-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 36px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .loja-layout-grid {
      /* minmax(0, …): o mapa (aspect-ratio + min-height) não pode alargar a coluna. */
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Mapa */
  .loja-map-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Cartões de Informação */
  .loja-cards-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lcard {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lcard-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }

  .lcard-title svg {
    color: var(--brand);
  }

  .lcard-body {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .horarios-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .horario-obs {
    margin: 6px 0 0;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .lcard-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .btn-lcard-primary {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: var(--btn);
    color: var(--btn-ink);
    font-weight: 700;
    font-size: 0.88rem;
    border-radius: 6px;
    text-decoration: none;
  }

  .btn-lcard-secondary {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .btn-lcard-secondary:hover {
    background: color-mix(in srgb, var(--line) 40%, transparent);
  }

  .btn-lcard-zap {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    background: var(--zap);
    color: var(--zap-ink);
    font-weight: 700;
    font-size: 0.88rem;
    border-radius: 6px;
    text-decoration: none;
  }

  /* Entrega */
  .loja-entrega-section {
    padding: 56px 0;
    background: color-mix(in srgb, var(--surface) 40%, transparent);
    border-top: 1px solid var(--line);
  }

  .sec-head {
    margin-bottom: 28px;
  }

  .sec-head h2 {
    font-size: 1.8rem;
    font-weight: 900;
    margin: 6px 0 8px;
    color: var(--ink);
  }

  .sec-sub {
    font-size: 0.95rem;
    color: var(--ink-2);
    max-width: 580px;
    margin: 0;
  }
</style>
