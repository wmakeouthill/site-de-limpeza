---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';

import { ProductCatalog } from '@/features/catalog/components/ProductCatalog';
import {
  getPublicDepartamentos,
  getPublicProdutos,
  getPublicSiteSettings,
} from '@/lib/server/publicCatalog';
import { DEFAULT_SITE_SETTINGS } from '@/lib/server/publicSettings';

export const prerender = false;

const [settingsResult, deptsResult, produtosResult] = await Promise.allSettled([
  getPublicSiteSettings(),
  getPublicDepartamentos(),
  getPublicProdutos(),
]);

const settings = settingsResult.status === "fulfilled" ? settingsResult.value : DEFAULT_SITE_SETTINGS;
const departamentos = deptsResult.status === "fulfilled" ? deptsResult.value : [];
const produtos = produtosResult.status === "fulfilled" ? produtosResult.value : [];

const searchParams = Astro.url.searchParams;
const initialQuery = searchParams.get('q') || '';
const initialDept = searchParams.get('departamento') || searchParams.get('departamento_slug') || '';
const initialOferta = searchParams.get('oferta') === 'true' || searchParams.get('oferta') === '1';
---

<BaseLayout
  title={`Produtos · Catálogo da Loja · ${settings.loja_nome}`}
  description="Catálogo de produtos de limpeza no Anil, Jacarepaguá. Preços de balcão na tela, ofertas ativas e montagem de lista para o WhatsApp."
>
  <Nav
    articlesEnabled={settings.articles_enabled}
    guidesEnabled={settings.guides_enabled}
    settings={settings}
  />

  <main id="main">
    <div class="wrap cat-page-head">
      <p class="cat-eyebrow">Catálogo da loja</p>
      <h1 class="cat-heading">Produtos</h1>
      <p class="cat-lede">
        Preços da loja física, atualizados pela equipe.
        <span class="only-emp">
          Comprando em quantidade? O preço de atacado a gente combina pelo WhatsApp.
        </span>
      </p>
    </div>

    <div class="wrap cat-container">
      <ProductCatalog
        client:load
        initialProdutos={produtos}
        departamentos={departamentos}
        initialDept={initialDept}
        initialQuery={initialQuery}
        initialOferta={initialOferta}
      />
    </div>
  </main>

  <Footer
    articlesEnabled={settings.articles_enabled}
    guidesEnabled={settings.guides_enabled}
    settings={settings}
  />

  <FloatingWhatsApp settings={settings} />
</BaseLayout>

<style is:global>
  .cat-page-head {
    padding: 36px 0 20px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .cat-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand);
    margin: 0 0 6px;
  }

  .cat-heading {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .cat-lede {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin: 0;
    max-width: 680px;
  }

  .cat-container {
    padding-bottom: 64px;
  }

  /* Catalog Layout */
  .catalog-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .catalog-layout {
      /* minmax(0, …): a barra de busca/ordenação não pode alargar a coluna. */
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Filters Sidebar */
  .cat-filters {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 18px;
  }

  .filters-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 16px;
  }

  .filters-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .btn-clear-filters {
    background: none;
    border: none;
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    padding: 2px 6px;
    margin-left: auto;
  }

  /* Só aparece quando os filtros ficam acima da grade (ver media query). */
  .filters-toggle {
    display: none;
    align-items: center;
    margin-left: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-clear-filters:hover {
    text-decoration: underline;
  }

  .filter-group {
    border: none;
    padding: 0;
    margin: 0 0 20px;
  }

  .filter-legend {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-bottom: 10px;
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .filter-radio,
  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--ink);
    cursor: pointer;
  }

  .filter-radio input,
  .filter-checkbox input {
    cursor: pointer;
    accent-color: var(--brand);
  }

  /* Catalog Main */
  .catalog-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .catalog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 16px;
  }

  .toolbar-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 240px;
  }

  .toolbar-search svg {
    position: absolute;
    left: 10px;
    color: var(--ink-3);
  }

  .toolbar-input {
    width: 100%;
    padding: 8px 30px 8px 32px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.88rem;
    background: var(--surface);
  }

  .toolbar-input:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 2px var(--focus);
  }

  .btn-clear-search {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    font-size: 1.1rem;
    color: var(--ink-3);
    cursor: pointer;
    line-height: 1;
  }

  .toolbar-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.88rem;
  }

  .results-count {
    color: var(--ink-2);
    font-weight: 600;
  }

  .sort-label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
  }

  .sort-select {
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.88rem;
    background: var(--surface);
    cursor: pointer;
  }

  /* Active Chips */
  .active-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--brand-soft);
    color: var(--brand);
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .filter-chip button {
    background: none;
    border: none;
    color: inherit;
    font-size: 1rem;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .btn-chip-clear {
    background: none;
    border: none;
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
  }

  /* Grid of products */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  /* Card */
  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cat-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .cat-card-thumb {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Foto no mesmo quadrado do enquadramento do CMS; as laterais ficam com a cor do selo. */
  .cat-thumb-photo {
    height: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .cat-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cat-badges {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-end;
  }

  .badge-grande {
    background: var(--btn);
    color: var(--btn-ink);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .badge-promo {
    background: var(--promo);
    color: var(--btn-ink);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .cat-card-body {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cat-meta {
    font-size: 0.78rem;
    color: var(--ink-2);
    margin-bottom: 4px;
  }

  .cat-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cat-pricing {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .price-from {
    font-size: 0.82rem;
    color: var(--ink-3);
    text-decoration: line-through;
  }

  .price-to,
  .price-normal {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--ink);
  }

  .price-to {
    color: var(--promo);
  }

  .cat-card-footer {
    padding: 0 16px 14px;
  }

  .cat-btn-add {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px;
    background: var(--surface-2);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .cat-btn-add:hover {
    background: var(--btn);
    color: var(--btn-ink);
    border-color: var(--brand);
  }

  /* Empty state */
  .catalog-empty {
    text-align: center;
    padding: 56px 24px;
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: 12px;
  }

  .catalog-empty h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 14px 0 6px;
    color: var(--ink);
  }

  .catalog-empty p {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin: 0 0 18px;
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
  }

  .btn-reset-filters {
    display: inline-flex;
    padding: 10px 20px;
    background: var(--btn);
    color: var(--btn-ink);
    font-weight: 700;
    font-size: 0.88rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    /* Acima da grade, os filtros começam recolhidos; o botão abre. */
    .cat-filters {
      padding: 12px 14px;
    }
    .filters-toggle {
      display: inline-flex;
    }
    .cat-filters:not(.is-open) .filters-header {
      padding-bottom: 0;
      border-bottom: 0;
      margin-bottom: 0;
    }
    .cat-filters:not(.is-open) .filters-body {
      display: none;
    }
  }

  @media (max-width: 760px) {
    /* O padding abreviado do .cat-page-head zera o gutter do .wrap. */
    .cat-page-head {
      padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px));
    }
    /* 2 colunas a partir de ~350px de tela; abaixo disso, 1. */
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }
    .cat-card-thumb {
      height: 140px;
    }
    .cat-card-body {
      padding: 12px;
    }
    .cat-card-footer {
      padding: 0 12px 12px;
    }
    .cat-pricing {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .toolbar-search {
      flex-basis: 100%;
      min-width: 0;
    }
    .toolbar-controls {
      flex-wrap: wrap;
      row-gap: 8px;
    }
  }
</style>
