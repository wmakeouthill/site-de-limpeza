---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Artigos from '../components/Artigos.astro';

import Hero from '@/features/home/components/Hero.astro';
import BenefitsBanner from '@/features/home/components/BenefitsBanner.astro';
import DepartmentGrid from '@/features/home/components/DepartmentGrid.astro';
import WeeklyOffers from '@/features/home/components/WeeklyOffers.astro';
import BusinessCallout from '@/features/home/components/BusinessCallout.astro';
import HowListWorks from '@/features/home/components/HowListWorks.astro';
import StoreSummary from '@/features/home/components/StoreSummary.astro';
import TestimonialGrid from '@/features/testimonials/components/TestimonialGrid.astro';

import { getHomeCatalogData } from '@/lib/server/publicCatalog';
import { getHomeEditorialData, getPublicTestimonials } from '@/lib/server/publicContent';

export const prerender = false;

const [catalog, editorial, testimonials] = await Promise.all([
  getHomeCatalogData(),
  getHomeEditorialData().catch(() => null),
  getPublicTestimonials().catch(() => []),
]);

const featuredOffer = catalog.ofertas.length > 0 ? catalog.ofertas[0] : null;
const settings = catalog.settings;
---

<BaseLayout
  title={`${settings.loja_nome} · Tudo limpo, sem complicar`}
  description="Loja de produtos de limpeza no Anil, Jacarepaguá. Preços da loja na tela, lista para WhatsApp e atendimento para casa e empresas."
>
  <Nav
    articlesEnabled={settings.articles_enabled}
    guidesEnabled={settings.guides_enabled}
    settings={settings}
  />

  <main id="main">
    <Hero settings={settings} featuredOffer={featuredOffer} />
    <BenefitsBanner prazoSeparacao={settings.prazo_separacao} />

    {catalog.departamentos.length > 0 && (
      <DepartmentGrid departamentos={catalog.departamentos} />
    )}

    {catalog.ofertas.length > 0 && (
      <WeeklyOffers ofertas={catalog.ofertas} ofertasValidade={catalog.ofertasValidade} />
    )}

    <BusinessCallout kits={catalog.kits} />
    <HowListWorks />
    <StoreSummary settings={settings} />

    {testimonials && testimonials.length > 0 && (
      <TestimonialGrid testimonials={testimonials} />
    )}

    {editorial && (
      <Artigos data={editorial} />
    )}
  </main>

  <Footer
    articlesEnabled={settings.articles_enabled}
    guidesEnabled={settings.guides_enabled}
    settings={settings}
  />

  <MobileNav settings={settings} />
  <FloatingWhatsApp settings={settings} />
</BaseLayout>
