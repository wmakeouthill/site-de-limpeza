---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSiteSettings } from '../lib/server/publicSettings';

export const prerender = false;

// Garante retorno 503 Service Unavailable conforme CA-27 sem expor detalhes técnicos
Astro.response.status = 503;
Astro.response.statusText = "Service Unavailable";

const settings = await getPublicSiteSettings();
const whatsappUrl = `https://wa.me/${settings.whatsapp_numero}?text=${encodeURIComponent("Olá! O site da Falcão Limpeza está instável e gostaria de fazer um pedido.")}`;
---

<BaseLayout
  title={`Serviço temporariamente indisponível · ${settings.loja_nome}`}
  description="Não foi possível carregar as informações agora. Nossa equipe já está verificando. Fale conosco pelo WhatsApp."
  showHeader={true}
  showFooter={true}
  settings={settings}
>
  <section class="error-page" aria-labelledby="error-title">
    <div class="error-container">
      <div class="error-badge">Status 503</div>
      <h1 id="error-title" class="error-heading">Serviço temporariamente indisponível</h1>
      <p class="error-description">
        Não conseguimos carregar as informações no momento. Nossa equipe já está verificando para normalizar o serviço o mais rápido possível.
      </p>

      <div class="error-card">
        <p class="error-card-text">
          Se você precisa de produtos com urgência ou quer tirar dúvidas sobre entrega no Anil e região, chame a loja diretamente no WhatsApp:
        </p>
        <div class="actions-group">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Falar pelo WhatsApp</span>
          </a>
          <button type="button" class="btn btn-outline" onclick="window.location.reload()">
            Tentar novamente
          </button>
          <a href="/" class="btn btn-ghost">
            Voltar ao início
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    padding: var(--space-12) var(--space-4);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-container {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .error-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .error-heading {
    font-size: clamp(1.8rem, 4vw, 2.2rem);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-3);
  }

  .error-description {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
  }

  .error-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow);
  }

  .error-card-text {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-6);
  }

  .actions-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .actions-group {
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-whatsapp {
    background: var(--zap);
    color: var(--zap-ink);
    border: 1px solid var(--zap);
  }

  .btn-whatsapp:hover {
    background: var(--zap);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .btn-outline:hover {
    background: var(--color-surface-sunken);
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
  }

  .btn-ghost:hover {
    color: var(--color-text);
  }
</style>
