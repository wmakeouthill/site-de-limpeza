---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSiteSettings } from '../lib/server/publicSettings';

export const prerender = false;

Astro.response.status = 404;

const settings = await getPublicSiteSettings();
const whatsappUrl = `https://wa.me/${settings.whatsapp_numero}?text=${encodeURIComponent("Olá! Não encontrei uma página no site e gostaria de tirar uma dúvida.")}`;
---

<BaseLayout
  title={`Página não encontrada · ${settings.loja_nome}`}
  description="A página que você procura não foi encontrada. Navegue pelo catálogo da Falcão Limpeza ou fale conosco pelo WhatsApp."
  showHeader={true}
  showFooter={true}
  settings={settings}
>
  <section class="error-page" aria-labelledby="error-title">
    <div class="error-container">
      <div class="error-badge">Erro 404</div>
      <h1 id="error-title" class="error-heading">Página não encontrada</h1>
      <p class="error-description">
        O endereço que você tentou acessar não existe, foi alterado ou o produto foi movido.
        Pesquise o que você procura ou use um dos atalhos abaixo:
      </p>

      <form action="/produtos" method="get" class="error-search-form" role="search">
        <label for="search-input" class="visually-hidden">Buscar produtos</label>
        <div class="search-input-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="search-input"
            type="search"
            name="q"
            placeholder="O que você precisa? Ex: cloro, detergente, rodo..."
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
      </form>

      <div class="quick-links" aria-label="Atalhos úteis">
        <h2 class="quick-links-title">Você também pode ir para:</h2>
        <div class="quick-links-grid">
          <a href="/produtos" class="quick-link-card">
            <span class="card-title">Catálogo de Produtos</span>
            <span class="card-desc">Veja tudo para casa e empresa</span>
          </a>
          <a href="/" class="quick-link-card">
            <span class="card-title">Página Inicial</span>
            <span class="card-desc">Conheça ofertas e destaques</span>
          </a>
          <a href="/loja" class="quick-link-card">
            <span class="card-title">Nossa Loja no Anil</span>
            <span class="card-desc">Endereço, horários e rotas</span>
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="quick-link-card highlight">
            <span class="card-title">Falar no WhatsApp</span>
            <span class="card-desc">Tire dúvidas direto com a equipe</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    padding: var(--space-12) var(--space-4);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-container {
    max-width: 640px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .error-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .error-heading {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-3);
  }

  .error-description {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
  }

  .error-search-form {
    margin-bottom: var(--space-10);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-3);
    box-shadow: var(--shadow);
  }

  .search-input-wrapper:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--focus);
  }

  .search-input-wrapper svg {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input-wrapper input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--color-text);
    outline: none;
  }

  .search-input-wrapper input::placeholder {
    color: var(--color-text-muted);
  }

  .quick-links {
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow);
  }

  .quick-links-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .quick-link-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .quick-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  .quick-link-card.highlight {
    background: var(--surface-2);
    border-color: var(--line);
  }

  .quick-link-card.highlight:hover {
    background: var(--brand-soft);
  }

  .card-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: 2px;
  }

  .card-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
