---
import type { PublicSiteSettings } from '../lib/server/publicSettings';

export interface Props {
  settings: PublicSiteSettings;
  currentPath?: string;
}

const { settings, currentPath = Astro.url.pathname } = Astro.props;
---

<header class="top">
  <div class="wrap">
    <div class="top-row">
      <!-- Logo Oficial Falcão Limpeza -->
      <a class="logo" href="/" aria-label="Falcão Limpeza - Página Inicial">
        <img
          class="mark"
          src="/brand/simbolo-40.webp"
          alt="Selo Falcão Limpeza"
          width="40"
          height="40"
          loading="eager"
          decoding="async"
        />
        <span class="lw">
          <b>Falcão</b>
          <span>Limpeza</span>
        </span>
      </a>

      <!-- Campo de Busca -->
      <form class="search" action="/produtos" method="GET" role="search">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="search"
          name="q"
          class="in"
          placeholder="Buscar desinfetante, rodo, balde…"
          aria-label="Buscar produtos no catálogo"
        />
      </form>

      <!-- Alternador de Modo: Casa vs Empresa -->
      <div class="seg" role="group" aria-label="Escolha seu perfil de compra">
        <button
          type="button"
          id="mode-btn-casa"
          data-mode="casa"
          aria-pressed="true"
        >
          <span class="l-long">Pra casa</span>
          <span class="l-short">Casa</span>
        </button>
        <button
          type="button"
          id="mode-btn-empresa"
          data-mode="empresa"
          aria-pressed="false"
        >
          <span class="l-long">Pra empresa</span>
          <span class="l-short">Empresa</span>
        </button>
      </div>

      <!-- Botão Minha Lista -->
      <a class="lista-btn" href="/lista" aria-label="Abrir minha lista de produtos">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
        <span class="lb-t">Minha lista</span>
        <span class="badge" id="header-list-count" data-count="0" aria-live="polite">0</span>
      </a>
    </div>

    <!-- Navegação principal -->
    <nav class="nav" aria-label="Navegação principal">
      <a class="n-ini" href="/" aria-current={currentPath === "/" ? "page" : undefined}>Início</a>
      <a class="n-bbar" href="/produtos" aria-current={currentPath.startsWith("/produtos") ? "page" : undefined}>Produtos</a>
      <a href="/empresas?modo=empresa" aria-current={currentPath === "/empresas" ? "page" : undefined}>Para empresas</a>
      {settings.guides_enabled && (
        <a href="/guias" aria-current={currentPath.startsWith("/guias") ? "page" : undefined}>Como usar</a>
      )}
      {settings.articles_enabled && (
        <a href="/artigos" aria-current={currentPath.startsWith("/artigos") ? "page" : undefined}>Dicas</a>
      )}
      <a class="n-bbar" href="/loja" aria-current={currentPath === "/loja" ? "page" : undefined}>A loja</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    function setupModeSwitch() {
      var btnCasa = document.getElementById('mode-btn-casa');
      var btnEmpresa = document.getElementById('mode-btn-empresa');
      if (!btnCasa || !btnEmpresa) return;

      function updateButtons(mode) {
        var isEmp = mode === 'empresa';
        btnCasa.setAttribute('aria-pressed', isEmp ? 'false' : 'true');
        btnEmpresa.setAttribute('aria-pressed', isEmp ? 'true' : 'false');
        if (isEmp) {
          document.documentElement.classList.add('mode-emp');
          document.body.classList.add('mode-emp');
        } else {
          document.documentElement.classList.remove('mode-emp');
          document.body.classList.remove('mode-emp');
        }
      }

      var currentMode = localStorage.getItem('talimpo-modo') || 'casa';
      updateButtons(currentMode);

      btnCasa.addEventListener('click', function() {
        localStorage.setItem('talimpo-modo', 'casa');
        updateButtons('casa');
      });

      btnEmpresa.addEventListener('click', function() {
        localStorage.setItem('talimpo-modo', 'empresa');
        updateButtons('empresa');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupModeSwitch);
    } else {
      setupModeSwitch();
    }
  })();
</script>

<style>
  .top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--bg);
    background: color-mix(in oklab, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .top-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 12px;
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 900 1.3rem/1 var(--font-sans);
    letter-spacing: -0.01em;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    color: var(--ink);
  }

  .mark {
    width: 40px;
    height: 40px;
    flex: none;
    object-fit: contain;
  }

  .lw {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .lw b {
    font-weight: 900;
    color: var(--logo-a);
  }

  .lw span {
    font: 800 0.56em/1 var(--font-sans);
    letter-spacing: 0.02em;
    color: var(--logo-b);
    border-bottom: 2px solid #FFC727;
    padding-bottom: 2px;
    align-self: flex-start;
  }

  .search {
    flex: 1;
    max-width: 440px;
    position: relative;
    display: flex;
    align-items: center;
    margin: 0;
  }

  .search > .ico {
    position: absolute;
    left: 14px;
    color: var(--ink-3);
    pointer-events: none;
  }

  .search .in {
    width: 100%;
    padding-left: 42px;
    padding-right: 14px;
    border-radius: 999px;
    min-height: 42px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }

  .search .in::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }

  .search .in:focus {
    outline: 2px solid var(--focus);
    border-color: transparent;
  }

  .seg {
    display: flex;
    background: var(--surface-2);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
    margin-left: auto;
  }

  .seg .l-short {
    display: none;
  }

  .seg button {
    border: 0;
    background: none;
    padding: 7px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--ink-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }

  .seg button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .lista-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    min-height: 42px;
    padding: 0 14px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.15s;
  }

  .lista-btn:hover {
    border-color: var(--brand-line);
  }

  .badge {
    min-width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-grid;
    place-items: center;
    padding: 0 5px;
    line-height: 1;
  }

  .badge[data-count="0"] {
    display: none;
  }

  .nav {
    display: flex;
    gap: 4px;
    padding: 2px 0 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav a {
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.92rem;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--surface-2);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .top {
      position: static;
    }
    .top-row {
      gap: 10px;
    }
    .search {
      order: 5;
      flex-basis: 100%;
      max-width: none;
    }
    .lb-t {
      display: none;
    }
    .seg .l-long {
      display: none;
    }
    .seg .l-short {
      display: inline;
    }
    .seg button {
      padding: 7px 10px;
    }
    /* Início, Produtos e A loja já estão na barra inferior (MobileNav). */
    .nav .n-ini,
    .nav .n-bbar {
      display: none;
    }
  }
</style>
