---
// Componente de Controle de Privacidade e LGPD para Falcão Limpeza
// Sem bibliotecas externas ou React: 100% Astro e JS nativo resiliente
---

<!-- Banner inferior de consentimento discreto (visível apenas na primeira visita / quando não configurado) -->
<aside
  id="talimpo-privacy-banner"
  role="region"
  aria-label="Aviso de privacidade e cookies"
  style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:90;background:var(--surface);border-top:1px solid var(--line);box-shadow:0 -6px 24px rgb(13 34 48 / 0.08);padding:18px 24px;font-family:var(--font-sans)"
>
  <div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 24px">
    <div style="flex:1 1 480px;min-width:0">
      <p style="margin:0;font-size:14px;line-height:1.6;color:var(--ink-2);font-weight:400">
        Utilizamos métricas anônimas estritamente técnicas para aprimorar o atendimento da loja e garantir a segurança da navegação, conforme a <strong style="color:var(--ink);font-weight:400">LGPD</strong>. Não utilizamos rastreadores invasivos de terceiros.
      </p>
    </div>
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px">
      <button
        type="button"
        id="privacy-banner-accept-btn"
        style="background:var(--btn);color:var(--btn-ink);border:none;border-radius:12px;font-family:var(--font-sans);font-size:12.5px;padding:10px 18px;cursor:pointer;font-weight:500;transition:opacity .2s"
      >
        Aceitar
      </button>
      <button
        type="button"
        id="privacy-banner-reject-btn"
        style="background:transparent;color:var(--ink-2);border:1px solid var(--line);border-radius:12px;font-family:var(--font-sans);font-size:12.5px;padding:10px 16px;cursor:pointer;font-weight:400;transition:color .2s, border-color .2s"
      >
        Apenas essenciais
      </button>
      <button
        type="button"
        id="privacy-banner-prefs-btn"
        style="background:transparent;color:var(--brand);border:none;font-family:var(--font-sans);font-size:12px;padding:10px 12px;cursor:pointer;text-decoration:underline;text-underline-offset:3px"
      >
        Preferências
      </button>
    </div>
  </div>
</aside>

<!-- Modal detalhado de preferências de privacidade -->
<div
  id="talimpo-privacy-modal-backdrop"
  style="display:none;position:fixed;inset:0;z-index:100;background:rgb(8 14 40 / 0.6);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:20px"
>
  <div
    id="talimpo-privacy-dialog"
    role="dialog"
    tabindex="-1"
    aria-modal="true"
    aria-labelledby="privacy-dialog-title"
    style="background:var(--surface);border:1px solid var(--line);border-radius:12px;max-width:580px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow);display:flex;flex-direction:column;font-family:var(--font-sans)"
  >
    <!-- Modal Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:22px 26px;border-bottom:1px solid var(--line)">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="width:7px;height:7px;background:var(--brand);transform:rotate(45deg);flex:none"></span>
        <h2 id="privacy-dialog-title" style="margin:0;font-family:var(--font-sans);font-weight:600;font-size:18px;letter-spacing:.08em;color:var(--ink)">
          Preferências de Privacidade
        </h2>
      </div>
      <button
        type="button"
        id="privacy-modal-close-btn"
        aria-label="Fechar preferências de privacidade"
        style="background:transparent;border:none;color:var(--ink-2);font-size:20px;cursor:pointer;padding:4px 8px;line-height:1;transition:color .2s"
      >
        ✕
      </button>
    </div>

    <!-- Modal Body -->
    <div style="padding:24px 26px;display:flex;flex-direction:column;gap:22px">
      <p style="margin:0;font-size:14px;line-height:1.65;color:var(--ink-2);font-weight:400">
        A <strong>Falcão Limpeza</strong> adota práticas transparentes de privacidade. Nossos registros de navegação são totalmente anônimos e servem para entender o uso do site e melhorar nosso catálogo e atendimento.
      </p>

      <!-- Seção 1: Métricas Anônimas -->
      <div style="background:var(--surface-2);border:1px solid var(--line);padding:18px 20px;display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <label for="privacy-analytics-checkbox" style="font-family:var(--font-sans);font-size:14px;color:var(--ink);cursor:pointer">
            Métricas Anônimas de Navegação
          </label>
          <input
            type="checkbox"
            id="privacy-analytics-checkbox"
            style="width:18px;height:18px;accent-color:var(--brand);cursor:pointer"
          />
        </div>
        <p style="margin:0;font-size:13px;line-height:1.6;color:var(--ink-2);font-weight:400">
          Contabiliza visualizações de páginas, tempo de permanência e interações de forma anônima e agregada, sem identificação pessoal e sem compartilhamento com corretores de dados.
        </p>
      </div>

      <!-- Seção 2: Comunicações e Campanhas -->
      <div style="background:var(--surface-2);border:1px solid var(--line);padding:18px 20px;display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <label for="privacy-marketing-checkbox" style="font-family:var(--font-sans);font-size:14px;color:var(--ink);cursor:pointer">
            Atribuição de campanhas
          </label>
          <input
            type="checkbox"
            id="privacy-marketing-checkbox"
            style="width:18px;height:18px;accent-color:var(--brand);cursor:pointer"
          />
        </div>
        <p style="margin:0;font-size:13px;line-height:1.6;color:var(--ink-2);font-weight:400">
          Permite mensurar quais artigos, guias ou links trouxeram você até a nossa loja, auxiliando na melhoria dos nossos conteúdos e ofertas.
        </p>
      </div>

      <!-- Seção 3: Esquecer meu dispositivo -->
      <div style="border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
          <div>
            <div style="font-family:var(--font-sans);font-size:13px;color:var(--ink-2)">
              Esquecer meu dispositivo
            </div>
            <p style="margin:4px 0 0;font-size:12.5px;color:var(--ink-2);line-height:1.5">
              Remove todas as referências armazenadas localmente e solicita a exclusão no servidor.
            </p>
          </div>
          <button
            type="button"
            id="privacy-forget-btn"
            style="background:transparent;border:1px solid var(--promo);color:var(--promo);font-family:var(--font-sans);font-size:11.5px;padding:8px 14px;border-radius:12px;cursor:pointer;white-space:nowrap;transition:background .2s, border-color .2s"
          >
            Apagar dados de navegação
          </button>
        </div>
        <div id="privacy-forget-feedback" style="display:none;font-size:12.5px;color:var(--zap);margin-top:4px">
          ✓ Dados apagados e rastreamento local desativado com sucesso.
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div style="padding:18px 26px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:flex-end;gap:12px;background:var(--surface-2)">
      <button
        type="button"
        id="privacy-modal-cancel-btn"
        style="background:transparent;border:none;color:var(--ink-2);font-family:var(--font-sans);font-size:12px;padding:9px 16px;cursor:pointer"
      >
        Cancelar
      </button>
      <button
        type="button"
        id="privacy-modal-save-btn"
        style="background:var(--btn);color:var(--btn-ink);border:none;border-radius:12px;font-family:var(--font-sans);font-size:12.5px;padding:10px 22px;cursor:pointer;font-weight:500"
      >
        Salvar preferências
      </button>
    </div>
  </div>
</div>

<style>
  #talimpo-privacy-banner button, #talimpo-privacy-dialog button { min-height: 44px; font-weight: 700 !important; }
  #talimpo-privacy-banner :focus-visible, #talimpo-privacy-dialog :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 600px) {
    #talimpo-privacy-banner { padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px)) !important; max-height: 80dvh; overflow-y: auto; }
    #talimpo-privacy-dialog { max-height: 90dvh !important; }
  }
</style>

<script>
  interface PrivacyState {
    analytics: "enabled" | "objected";
    marketing: "granted" | "denied" | "unset";
    version?: string;
    updated_at?: string;
  }

  const STORAGE_KEY = "talimpo_privacy:falcao";
  const LEGACY_STORAGE_KEY = "au_privacy:falcao";

  function readPrivacyLocal(): PrivacyState {
    try {
      const raw =
        (typeof window !== "undefined" && (window as any).talimpoPrivacy?.get?.()) ||
        (typeof window !== "undefined" && (window as any).auPrivacy?.get?.());
      if (raw) return raw;

      const stored = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        return {
          analytics: parsed.analytics === "objected" ? "objected" : "enabled",
          marketing: parsed.marketing === "granted" || parsed.marketing === "denied" ? parsed.marketing : "unset",
          version: parsed.version || "2026-08-30",
          updated_at: parsed.updated_at || ""
        };
      }
    } catch {
      // Fallback
    }
    return { analytics: "enabled", marketing: "unset" };
  }

  function setPrivacy(choice: { analytics: "enabled" | "objected"; marketing: "granted" | "denied" }) {
    if (typeof window !== "undefined" && (window as any).talimpoPrivacy?.set) {
      return (window as any).talimpoPrivacy.set(choice);
    }
    if (typeof window !== "undefined" && (window as any).auPrivacy?.set) {
      return (window as any).auPrivacy.set(choice);
    }
    try {
      const state = {
        analytics: choice.analytics,
        marketing: choice.marketing,
        version: "2026-08-30",
        updated_at: new Date().toISOString()
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      window.dispatchEvent(new CustomEvent("talimpoprivacychange", { detail: state }));
      return state;
    } catch {
      return choice;
    }
  }

  function forgetPrivacy() {
    if (typeof window !== "undefined" && (window as any).talimpoPrivacy?.forget) {
      (window as any).talimpoPrivacy.forget();
      return;
    }
    if (typeof window !== "undefined" && (window as any).auPrivacy?.forget) {
      (window as any).auPrivacy.forget();
      return;
    }
    try {
      setPrivacy({ analytics: "objected", marketing: "denied" });
      localStorage.removeItem("talimpo_track_session");
      localStorage.removeItem("talimpo_attribution:falcao");
    } catch {
      // Ignore
    }
  }

  // DOM Elements
  const banner = document.getElementById("talimpo-privacy-banner");
  const modalBackdrop = document.getElementById("talimpo-privacy-modal-backdrop");
  const dialog = document.getElementById("talimpo-privacy-dialog");

  const bannerAcceptBtn = document.getElementById("privacy-banner-accept-btn");
  const bannerRejectBtn = document.getElementById("privacy-banner-reject-btn");
  const bannerPrefsBtn = document.getElementById("privacy-banner-prefs-btn");

  const modalCloseBtn = document.getElementById("privacy-modal-close-btn");
  const modalCancelBtn = document.getElementById("privacy-modal-cancel-btn");
  const modalSaveBtn = document.getElementById("privacy-modal-save-btn");
  const forgetBtn = document.getElementById("privacy-forget-btn");
  const forgetFeedback = document.getElementById("privacy-forget-feedback");

  const analyticsCheckbox = document.getElementById("privacy-analytics-checkbox") as HTMLInputElement | null;
  const marketingCheckbox = document.getElementById("privacy-marketing-checkbox") as HTMLInputElement | null;

  function updateBannerVisibility() {
    const state = readPrivacyLocal();
    if (banner) {
      if (state.marketing === "unset") {
        banner.style.display = "block";
      } else {
        banner.style.display = "none";
      }
    }
  }

  function openModal() {
    const state = readPrivacyLocal();
    if (analyticsCheckbox) {
      analyticsCheckbox.checked = state.analytics !== "objected";
    }
    if (marketingCheckbox) {
      // Marcada por padrão (igual ao "Aceitar"); só desmarca quem já recusou.
      marketingCheckbox.checked = state.marketing !== "denied";
    }
    if (forgetFeedback) {
      forgetFeedback.style.display = "none";
    }
    if (modalBackdrop) {
      modalBackdrop.style.display = "flex";
      dialog?.focus();
    }
  }

  function closeModal() {
    if (modalBackdrop) {
      modalBackdrop.style.display = "none";
    }
  }

  // Handlers do Banner
  bannerAcceptBtn?.addEventListener("click", () => {
    setPrivacy({ analytics: "enabled", marketing: "granted" });
    if (banner) banner.style.display = "none";
  });

  bannerRejectBtn?.addEventListener("click", () => {
    setPrivacy({ analytics: "objected", marketing: "denied" });
    if (banner) banner.style.display = "none";
  });

  bannerPrefsBtn?.addEventListener("click", () => {
    openModal();
  });

  // Handlers do Modal
  modalCloseBtn?.addEventListener("click", closeModal);
  modalCancelBtn?.addEventListener("click", closeModal);

  modalBackdrop?.addEventListener("click", (e) => {
    if (e.target === modalBackdrop) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modalBackdrop?.style.display === "flex") {
      closeModal();
    }
  });

  modalSaveBtn?.addEventListener("click", () => {
    const analytics = analyticsCheckbox?.checked ? "enabled" : "objected";
    const marketing = marketingCheckbox?.checked ? "granted" : "denied";
    setPrivacy({ analytics, marketing });
    closeModal();
    if (banner) banner.style.display = "none";
  });

  forgetBtn?.addEventListener("click", () => {
    forgetPrivacy();
    if (analyticsCheckbox) analyticsCheckbox.checked = false;
    if (marketingCheckbox) marketingCheckbox.checked = false;
    if (forgetFeedback) {
      forgetFeedback.style.display = "block";
    }
    if (banner) banner.style.display = "none";
  });

  // Global Events
  window.addEventListener("talimpoprivacyopen", openModal);

  window.addEventListener("talimpoprivacychange", () => {
    updateBannerVisibility();
  });

  // Inicialização
  updateBannerVisibility();
</script>
