---
import type { PublicArticleSummary } from '@/lib/server/publicContent';
import TestedBadge from '@/features/content/components/TestedBadge.astro';

interface Props {
  article: PublicArticleSummary;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;

const imagePositionStyle = article.thumbnail
  ? `object-position: ${article.thumbnail_position_x ?? 50}% ${article.thumbnail_position_y ?? 50}%; transform: scale(${(article.thumbnail_zoom ?? 100) / 100}); transform-origin: ${article.thumbnail_position_x ?? 50}% ${article.thumbnail_position_y ?? 50}%;`
  : '';

const isTestamos = article.categoria === 'testamos';
---

<article
  class={`article-card ${featured ? 'article-card--featured' : ''}`}
>
  {article.thumbnail ? (
    <div class="card-thumb">
      <img
        src={article.thumbnail}
        alt={article.thumbnail_alt || article.title}
        loading="lazy"
        decoding="async"
        style={imagePositionStyle}
      />
      {isTestamos && (
        <div class="thumb-badge">
          <TestedBadge size="sm" />
        </div>
      )}
    </div>
  ) : (
    <div class="card-thumb-placeholder">
      <span class="placeholder-text">TÁ LIMPO!</span>
      {isTestamos && (
        <div class="thumb-badge">
          <TestedBadge size="sm" />
        </div>
      )}
    </div>
  )}

  <div class="card-body">
    <div class="card-meta">
      <span class="area-tag">{article.area || 'Dicas'}</span>
      <span class="separator">·</span>
      <span class="time-tag">{article.reading_time}</span>
      {isTestamos && !article.thumbnail && (
        <TestedBadge size="sm" class="inline-badge" />
      )}
    </div>

    <h3 class={`card-title ${featured ? 'card-title--featured' : ''}`}>
      <a href={`/artigos/${article.slug}`} class="article-title-link">
        {article.title}
      </a>
    </h3>

    <div class="card-footer">
      <a
        href={`/artigos/${article.slug}`}
        class="read-more-link"
        aria-label={`Ler artigo completo: ${article.title}`}
      >
        <span>Ler artigo</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
    box-shadow: var(--shadow);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--brand-line);
  }

  .card-thumb,
  .card-thumb-placeholder {
    aspect-ratio: 16/9;
    overflow: hidden;
    position: relative;
    background: var(--surface-2);
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-thumb img {
    transform: scale(1.03);
  }

  .thumb-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
  }

  .card-thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-soft);
  }

  .placeholder-text {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.1em;
    color: var(--brand);
  }

  .card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--ink-3);
    flex-wrap: wrap;
  }

  .area-tag {
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  .separator {
    opacity: 0.5;
  }

  .card-title {
    margin: 0 0 16px;
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    color: var(--ink);
  }

  .card-title--featured {
    font-size: 22px;
  }

  .article-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-card:hover .article-title-link {
    color: var(--brand);
  }

  .card-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 13px;
    color: var(--brand);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: gap 0.15s ease;
  }

  .read-more-link:hover {
    gap: 10px;
    color: var(--brand-strong);
  }
</style>
