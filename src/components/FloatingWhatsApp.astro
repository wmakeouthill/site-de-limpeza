---
import type { PublicSiteSettings } from '../lib/server/publicSettings';

export interface Props {
  settings: PublicSiteSettings;
}

const { settings } = Astro.props;
const waUrl = `https://wa.me/${settings.whatsapp_numero}?text=Ol%C3%A1%2C%20${encodeURIComponent(settings.loja_nome)}!%20Gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20produtos.`;
---

<a
  class="fab btn btn-zap"
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-target="flutuante"
  aria-label={`Falar no WhatsApp da ${settings.loja_nome}`}
>
  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
  </svg>
  <span>Fale com a loja</span>
</a>

<style>
  .fab {
    position: fixed;
    right: calc(24px + env(safe-area-inset-right, 0px));
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 25;
    box-shadow: 0 4px 16px rgba(23, 122, 66, 0.35);
    font-weight: 700;
  }

  .fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(23, 122, 66, 0.45);
  }

  @media (max-width: 760px) {
    .fab {
      display: none;
    }
  }
</style>
