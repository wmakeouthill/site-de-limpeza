---
import ProductIllustration from "@/features/catalog/components/ProductIllustration.astro";
import type { PublicProduto } from "@/lib/server/publicCatalog";
import { formatBrl } from "@/features/list/utils/whatsappFormatter";
import { fotoStyle } from "@/features/catalog/utils/productPhoto";

export interface Props {
  ofertas: PublicProduto[];
  ofertasValidade?: string | null;
}

const { ofertas, ofertasValidade } = Astro.props;
const displayOfertas = ofertas.slice(0, 8);
---

{displayOfertas.length > 0 && (
  <section class="sec sec-tint" id="ofertas">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Ofertas da semana</p>
          <h2>O que está valendo a pena</h2>
          <p>
            Válido até {ofertasValidade || "sábado"} ou enquanto durar o estoque.
          </p>
        </div>
        <a class="link" href="/produtos?oferta=true">
          Ver todas as ofertas
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="grid">
        {displayOfertas.map((prod) => {
          const offerPrice = prod.preco_por || prod.preco_atual;
          const hasOldPrice = Boolean(prod.preco_de && prod.preco_de !== offerPrice);
          return (
            <article class="card">
              <a class="card-hit" href={`/produtos/${prod.slug}`}>
                <div class="tile" style={{ "--c": prod.cor || "#1B3FA0" }}>
                  {prod.imagem_url ? (
                    <span class="tile-photo">
                      <img
                        src={prod.imagem_url}
                        alt={prod.nome}
                        loading="lazy"
                        decoding="async"
                        class="tile-img"
                        style={fotoStyle(prod.imagem_posicao, prod.imagem_zoom)}
                      />
                    </span>
                  ) : (
                    <ProductIllustration
                      forma={prod.forma || "garrafa"}
                      cor={prod.cor || "#1B3FA0"}
                      width={100}
                      height={140}
                    />
                  )}

                  {prod.desconto_pct && (
                    <span class="off">-{prod.desconto_pct}%</span>
                  )}
                </div>

                {prod.marca && <span class="marca">{prod.marca}</span>}
                <h3 class="nm">{prod.nome}</h3>
                {prod.tamanho && <span class="tam">{prod.tamanho}</span>}

                <div class="price">
                  {hasOldPrice && (
                    <span class="de">de <s>{formatBrl(prod.preco_de)}</s></span>
                  )}
                  <span class="por on">
                    <small>por </small>{formatBrl(offerPrice)}
                  </span>
                </div>
              </a>

              <div class="acts">
                <button
                  type="button"
                  class="btn btn-soft btn-sm btn-full btn-add-list"
                  data-add-to-list
                  data-product-id={prod.id}
                  data-product-name={prod.nome}
                  data-product-price={prod.preco_atual}
                >
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  Pôr na lista
                </button>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<script is:inline>
  (function() {
    if (window.__weeklyOffersAddBound) return;
    window.__weeklyOffersAddBound = true;

    document.addEventListener("click", function(e) {
      var target = e.target;
      if (!target || typeof target.closest !== "function") return;
      var btn = target.closest("#ofertas [data-add-to-list]");
      if (!btn) return;

      e.preventDefault();
      var id = btn.getAttribute("data-product-id");
      if (!id) return;

      var nome = btn.getAttribute("data-product-name") || "Produto";
      var preco = btn.getAttribute("data-product-price") || "";

      window.dispatchEvent(new CustomEvent("talimpo:add-to-list", {
        detail: {
          id: id,
          nome: nome,
          preco: preco,
          quantidade: 1,
        },
      }));

      if (typeof window.showToast === "function") {
        window.showToast(nome + " adicionado à lista");
      }
    });
  })();
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 20px;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-hit {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    text-decoration: none;
    color: inherit;
    border-radius: 18px;
  }

  .tile {
    --tile: color-mix(in oklab, var(--c, #1B3FA0) 14%, var(--surface));
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    background: var(--tile);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* A foto ocupa o tile inteiro: é o mesmo quadrado do enquadramento no CMS. */
  .tile-photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .tile-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* O wrapper do ProductIllustration é flex: o % abaixo resolve contra o tile.
     Em grid com coluna auto o % virava 44% de 100px. */
  .tile :global(svg) {
    width: 44%;
    height: auto;
    max-height: 76%;
    transition: transform 0.25s ease;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.14));
  }

  .card-hit:hover .tile :global(svg),
  .card-hit:hover .tile-photo {
    transform: scale(1.04);
  }

  .off {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--surface);
    color: var(--promo);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 9px;
    border-radius: 999px;
    line-height: 1;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .marca {
    font-size: 0.72rem;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .nm {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
  }

  .card-hit:hover .nm {
    color: var(--brand);
  }

  .tam {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .price {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .price .de {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .price .por.on {
    color: var(--promo);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .price .por.on small {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .acts {
    margin-top: 4px;
  }

  .btn-add-list .ico {
    width: 16px;
    height: 16px;
  }
</style>
