---
export interface Props {
  prazoSeparacao?: string | null;
}

const { prazoSeparacao = "Separado em ~30 min" } = Astro.props;
---

<section class="wrap">
  <ul class="trust">
    <li>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 12V4h8l10 10-8 8z" />
        <circle cx="7.5" cy="8.5" r="1.3" />
      </svg>
      <div>
        <b>Preço da loja, na tela</b>
        <span>O mesmo que você paga no balcão.</span>
      </div>
    </li>

    {prazoSeparacao && (
      <li>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        <div>
          <b>{prazoSeparacao}</b>
          <span>Mande a lista e passe pra buscar.</span>
        </div>
      </li>
    )}

    <li>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7" />
        <circle cx="7" cy="17.5" r="1.8" />
        <circle cx="17" cy="17.5" r="1.8" />
      </svg>
      <div>
        <b>Entrega na região</b>
        <span>Consulte seu bairro no WhatsApp.</span>
      </div>
    </li>

    <li>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 13h8v8H3zM13 13h8v8h-8zM8 3h8v8H8z" />
      </svg>
      <div>
        <b>Atacado pra empresas</b>
        <span>Preço combinado pelo WhatsApp.</span>
      </div>
    </li>
  </ul>
</section>

<style>
  .trust {
    padding: 22px 0;
    margin: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    border-block: 1px solid var(--line);
  }

  .trust li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  .trust .ico {
    color: var(--brand);
    flex: none;
    margin-top: 2px;
  }

  .trust b {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 420px) {
    .trust {
      grid-template-columns: 1fr;
    }
  }
</style>
