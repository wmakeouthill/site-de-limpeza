---
import type { PublicSiteSettings } from "@/lib/server/publicCatalog";
import StoreMap from "@/features/store/components/StoreMap.astro";

export interface Props {
  settings: PublicSiteSettings;
}

const { settings } = Astro.props;
---

<section class="sec">
  <div class="wrap loja-t">
    <div>
      <StoreMap nome={settings.loja_nome} endereco={settings.endereco} />
    </div>

    <div class="loja-txt">
      <p class="eyebrow">Visite a loja</p>
      <h2>No Anil, pertinho de Rio das Pedras</h2>
      <address>
        {settings.endereco}<br />
        {settings.bairro_cidade}
        {settings.referencia_endereco && ` (${settings.referencia_endereco})`}
      </address>
      <p class="muted">
        Seg a sáb, 8h às 19h · Dom, 8h às 13h
        {settings.horario_obs && ` (${settings.horario_obs})`}
      </p>
      <div class="row">
        {settings.maps_url && (
          <a class="btn" href={settings.maps_url} target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>
        )}
        <a class="link" href="/loja">
          Detalhes da loja
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .loja-t {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .loja-txt {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .loja-txt h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.2rem);
  }

  address {
    font-style: normal;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
  }

  @media (max-width: 860px) {
    .loja-t {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
