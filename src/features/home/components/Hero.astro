---
import type { PublicProduto, PublicSiteSettings } from "@/lib/server/publicCatalog";
import { formatBrl } from "@/features/list/utils/whatsappFormatter";

export interface Props {
  settings: PublicSiteSettings;
  featuredOffer?: PublicProduto | null;
}

const { settings, featuredOffer } = Astro.props;
const prazoSeparacao = settings.prazo_separacao || "Separado em ~30 min";
const offerPrice = featuredOffer?.preco_por || featuredOffer?.preco_atual;
const hasOldPrice = Boolean(
  featuredOffer?.preco_de &&
  offerPrice &&
  featuredOffer.preco_de !== offerPrice
);
---

<section class="hero wrap">
  <div class="hero-txt">
    <p class="eyebrow">
      <span class="only-casa">Loja de limpeza no Anil · Jacarepaguá</span>
      <span class="only-emp">Atacado de limpeza no Anil · Jacarepaguá</span>
    </p>

    <h1 class="display">Tudo limpo, sem complicar.</h1>

    <p class="lede only-casa">
      Veja o preço antes de sair de casa, monte sua lista com calma e retire no Anil — ou pergunte se a gente entrega no seu bairro.
    </p>
    <p class="lede only-emp">
      Condomínios, restaurantes, salões e escritórios: pedido pelo WhatsApp, preço de atacado combinado com você e tudo separado quando você chegar.
    </p>

    <div class="ctas">
      <a class="btn" href="/produtos">
        Ver produtos
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="btn btn-sec" href="/loja">Como chegar</a>
      <a class="btn btn-sec only-emp" href="/empresas">Kits e cotação</a>
    </div>

    <p class="hero-addr">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </svg>
      <span>
        {settings.endereco} · {settings.bairro_cidade}
        {settings.referencia_endereco && ` (${settings.referencia_endereco})`}
      </span>
    </p>
  </div>

  <div class="hero-art">
    <div class="ha-bg" aria-hidden="true"></div>

    <!-- Galão ilustrativo (mesmo padrão cromático do protótipo) -->
    <div class="ha-p ha-1" style="--c: #8E7CC3;" aria-hidden="true">
      <svg viewBox="0 0 100 140">
        <rect x="52" y="16" width="20" height="13" rx="3" fill="var(--cap)" />
        <path d="M24 36h28v-8h20v8h4c6 0 10 4 10 10v76c0 6-4 10-10 10H24c-6 0-10-4-10-10V46c0-6 4-10 10-10z" fill="var(--c)" />
        <path d="M60 44h14a3 3 0 0 1 3 3v13H63a3 3 0 0 1-3-3z" fill="var(--tile)" />
        <rect x="22" y="72" width="56" height="42" rx="5" fill="#FFFFFF" />
        <rect x="30" y="84" width="40" height="5" rx="2.5" fill="var(--c)" />
        <rect x="30" y="95" width="26" height="4" rx="2" fill="var(--c2)" />
      </svg>
    </div>

    <!-- Borrifador / Spray -->
    <div class="ha-p ha-2" style="--c: #3AAFA9;" aria-hidden="true">
      <svg viewBox="0 0 100 140">
        <rect x="40" y="40" width="18" height="16" fill="var(--cap)" />
        <rect x="30" y="22" width="40" height="18" rx="6" fill="var(--cap)" />
        <rect x="20" y="27" width="14" height="8" rx="2" fill="var(--cap)" />
        <path d="M46 40l-7 17h6l7-17z" fill="var(--cap)" />
        <path d="M36 54h28c4 0 7 3 7 7v61c0 6-4 10-10 10H39c-6 0-10-4-10-10V61c0-4 3-7 7-7z" fill="var(--c)" />
        <rect x="35" y="76" width="30" height="38" rx="4" fill="#FFFFFF" />
        <rect x="40" y="88" width="20" height="4" rx="2" fill="var(--c)" />
        <rect x="40" y="97" width="12" height="3" rx="1.5" fill="var(--c2)" />
      </svg>
    </div>

    <!-- Frasco Detergente -->
    <div class="ha-p ha-3" style="--c: #7DB548;" aria-hidden="true">
      <svg viewBox="0 0 100 140">
        <path d="M44 10h12l3 18H41z" fill="var(--cap)" />
        <path d="M40 27h20l7 17v78c0 6-4 10-10 10H43c-6 0-10-4-10-10V44z" fill="var(--c)" />
        <rect x="38" y="68" width="24" height="44" rx="4" fill="#FFFFFF" />
        <circle cx="50" cy="84" r="6" fill="var(--c)" />
        <rect x="42" y="98" width="16" height="3" rx="1.5" fill="var(--c2)" />
      </svg>
    </div>

    {featuredOffer && (
      <div class="ha-note" id="ha-note">
        <span class="s">Esta semana</span>
        <b>
          {featuredOffer.nome}
          {featuredOffer.tamanho ? ` ${featuredOffer.tamanho}` : ""}
        </b>
        <div class="price">
          {hasOldPrice && <s>{formatBrl(featuredOffer.preco_de)}</s>}
          <span class="on">{formatBrl(featuredOffer.preco_por || featuredOffer.preco_atual)}</span>
        </div>
      </div>
    )}

    {prazoSeparacao && (
      <div class="ha-chip">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        <span>{prazoSeparacao}</span>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: center;
    padding-block: 56px 40px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 36px;
    }
  }

  .hero-txt {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-addr {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-3);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .hero-addr .ico {
    width: 18px;
    height: 18px;
    color: var(--brand);
    flex: none;
  }

  .hero-art {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    --tile: var(--brand-soft);
  }

  @media (max-width: 860px) {
    .hero-art {
      max-width: 420px;
    }
  }

  .ha-bg {
    position: absolute;
    inset: 6% 8% 0;
    background: var(--brand-soft);
    border-radius: 999px 999px 28px 28px;
  }

  .ha-p {
    position: absolute;
    height: auto;
    --c2: color-mix(in oklab, var(--c) 18%, #ffffff);
    --cap: color-mix(in oklab, var(--c) 55%, #0d2230);
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.14));
  }

  .ha-p svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ha-1 {
    left: 14%;
    bottom: 8%;
    width: 42%;
    z-index: 2;
  }

  .ha-2 {
    left: 40%;
    bottom: 16%;
    width: 32%;
    z-index: 1;
  }

  .ha-3 {
    right: 8%;
    bottom: 8%;
    width: 26%;
    z-index: 3;
  }

  .ha-note {
    position: absolute;
    top: 12%;
    left: 0;
    z-index: 4;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 12px 16px;
    box-shadow: var(--shadow);
    max-width: min(240px, 62%);
  }

  .ha-note .s {
    display: block;
    font-size: 0.85rem;
    color: var(--ink);
    font-weight: 600;
  }

  .ha-note b {
    display: block;
    margin-top: 2px;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
  }

  .ha-note .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .ha-note s {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .ha-note .on {
    color: var(--promo);
    font-weight: 800;
    font-size: 1rem;
  }

  .ha-chip {
    position: absolute;
    right: 0;
    top: 46%;
    z-index: 4;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    box-shadow: var(--shadow);
    max-width: calc(100% - 16px);
  }

  .ha-chip .ico {
    width: 16px;
    height: 16px;
    color: var(--brand);
  }

  @media (max-width: 420px) {
    .ha-note {
      top: 8%;
      padding: 10px 12px;
    }

    .ha-chip {
      padding: 7px 12px;
      font-size: 0.8rem;
    }
  }
</style>
