---
import type { PublicKit } from "@/lib/server/publicCatalog";
import { formatBrl } from "@/features/list/utils/whatsappFormatter";

export interface Props {
  kits?: PublicKit[];
}

const { kits = [] } = Astro.props;
// Total no preço de balcão, como o KitCard de /empresas.
const displayKits = kits.slice(0, 4).map((kit) => ({
  ...kit,
  total: kit.itens.reduce(
    (sum, item) => sum + (item.produto ? parseFloat(item.produto.preco_atual.replace(",", ".")) * item.quantidade : 0),
    0
  ),
}));
---

<section class="sec band">
  <div class="wrap band-in">
    <div>
      <p class="eyebrow">Para empresas</p>
      <h2>Compra pra empresa? A gente separa pra você.</h2>
      <p>
        Condomínio, restaurante, salão ou escritório: faça o pedido pelo WhatsApp e combine o preço de atacado com a gente.
      </p>
      <a class="btn" href="/empresas?modo=empresa">
        Conhecer o atacado
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>

    {displayKits.length > 0 && (
      <div class="kits-mini">
        {displayKits.map((kit) => (
          <a class="kitp" href="/empresas?modo=empresa">
            <b>{kit.nome}</b>
            <small>{kit.descricao || kit.publico}</small>
            {kit.total > 0 && <span class="v">{formatBrl(kit.total)}</span>}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .band {
    background: var(--band);
    color: var(--on-band);
  }

  .band .eyebrow {
    color: var(--band-accent);
  }

  .band-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 40px;
    align-items: center;
  }

  .band-in > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .band h2 {
    color: var(--on-band);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.3rem);
  }

  .band p {
    color: var(--on-band-2);
  }

  .band .btn {
    background: var(--on-band);
    color: var(--band);
    align-self: flex-start;
  }

  .kits-mini {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .kitp {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px;
    border: 1px solid var(--band-line);
    border-radius: 16px;
    color: var(--on-band);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .kitp:hover {
    border-color: var(--band-accent);
  }

  .kitp b {
    font-weight: 600;
  }

  .kitp small {
    color: var(--on-band-2);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kitp .v {
    color: var(--band-accent);
    font-weight: 700;
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .band-in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
